# Replace with the IPv4 address of the computer running Backend/app.py.
# The phone and computer must be on the same local network.
EXPO_PUBLIC_API_URL=http://192.168.100.32:8000
# Optional. Must match JARVIS_API_TOKEN in the backend.
EXPO_PUBLIC_API_TOKEN=
# Optional profile fact shown in front-camera owner overlay. Never inferred from appearance.
EXPO_PUBLIC_OWNER_AGE=
